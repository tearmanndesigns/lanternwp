{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"palette": [
				{ "slug": "text-primary", "name": "Text Primary", "color": "#1A1A1A" },
				{ "slug": "text-secondary", "name": "Text Secondary", "color": "#4D4D4D" },
				{ "slug": "background", "name": "Background", "color": "#FFFFFF" },
				{ "slug": "surface", "name": "Surface", "color": "#F5F3EF" },
				{ "slug": "primary", "name": "Primary", "color": "#8A5A00" },
				{ "slug": "primary-dark", "name": "Primary Dark", "color": "#6B4500" },
				{ "slug": "secondary", "name": "Secondary", "color": "#0B5E45" },
				{ "slug": "error", "name": "Error", "color": "#B3261E" },
				{ "slug": "success", "name": "Success", "color": "#1E6B3C" },
				{ "slug": "border", "name": "Border", "color": "#D9D5CC" }
			],
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "\"Atkinson Hyperlegible Next\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "1rem" },
				{ "slug": "base", "name": "Base", "size": "1.125rem" },
				{ "slug": "heading-6", "name": "Heading 6", "size": "clamp(1.125rem, 1.011rem + 0.455vw, 1.375rem)" },
				{ "slug": "heading-5", "name": "Heading 5", "size": "clamp(1.375rem, 1.219rem + 0.625vw, 1.719rem)" },
				{ "slug": "heading-4", "name": "Heading 4", "size": "clamp(1.719rem, 1.523rem + 0.784vw, 2.15rem)" },
				{ "slug": "heading-3", "name": "Heading 3", "size": "clamp(2.15rem, 1.906rem + 0.977vw, 2.6875rem)" },
				{ "slug": "heading-2", "name": "Heading 2", "size": "clamp(2.6875rem, 2.384rem + 1.216vw, 3.356rem)" },
				{ "slug": "heading-1", "name": "Heading 1", "size": "clamp(3.356rem, 2.976rem + 1.523vw, 4.194rem)" }
			],
			"customFontSize": false,
			"fluid": false,
			"lineHeight": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": false,
			"dropCap": false
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "1", "name": "1", "size": "0.25rem" },
				{ "slug": "2", "name": "2", "size": "0.5rem" },
				{ "slug": "3", "name": "3", "size": "0.75rem" },
				{ "slug": "4", "name": "4", "size": "1rem" },
				{ "slug": "6", "name": "6", "size": "clamp(1.125rem, 0.955rem + 0.682vw, 1.5rem)" },
				{ "slug": "8", "name": "8", "size": "clamp(1.5rem, 1.273rem + 0.909vw, 2rem)" },
				{ "slug": "12", "name": "12", "size": "clamp(2.25rem, 1.909rem + 1.364vw, 3rem)" },
				{ "slug": "16", "name": "16", "size": "clamp(3rem, 2.545rem + 1.818vw, 4rem)" },
				{ "slug": "24", "name": "24", "size": "clamp(4.5rem, 3.818rem + 2.727vw, 6rem)" }
			],
			"customSpacingSize": false,
			"units": [ "rem", "vw", "%" ],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"layout": {
			"contentSize": "48rem",
			"wideSize": "80rem"
		},
		"custom": {
			"focus-ring-color": "var(--wp--preset--color--primary)",
			"focus-ring-width": "2px",
			"focus-ring-offset": "2px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text-primary)"
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontFamily": "var(--wp--preset--font-family--body)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--primary-dark)" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--text-primary)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-1)", "lineHeight": "1.1" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-2)", "lineHeight": "1.15" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-3)", "lineHeight": "1.2" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-4)", "lineHeight": "1.3" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-5)", "lineHeight": "1.3" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-6)", "lineHeight": "1.4" } }
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--6)"
		}
	}
}
